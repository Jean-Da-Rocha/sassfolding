{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint . --debug",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "vitest": "vitest run",
    "vue-tsc": "vue-tsc --noEmit"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@internationalized/date": "~3.12.4",
    "@nuxt/ui": "^4.11.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "~9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@iconify-json/lucide": "^1.2.136",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@unhead/vue": "^3.4.1",
    "@vue/runtime-core": "^3.5.43",
    "@vueuse/core": "^15.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "husky": "^9.1.7",
    "hybridly": "0.10.0-beta.36",
    "lint-staged": "^17.5.1",
    "tailwindcss": "^4.3.3",
    "taze": "^21.1.0",
    "typescript": "^5.9.3",
    "unplugin-icons": "^24.0.0",
    "validate-branch-name": "^1.3.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "**/*.{vue,ts}": "eslint --fix",
    "**/*.php": "vendor/bin/pint"
  },
  "validate-branch-name": {
    "pattern": "^(build|bugfix|bump|docs|experimental|feature|hotfix|merge|refactor|release|test)(/[A-Z]+\\-\\d+)?/[a-z0-9]+(-[a-z0-9]+)*(?:-\\d+)?$",
    "errorMsg": "Incorrect branch name, please refer to the regex documentation -> https://extendsclass.com/regex/f92c0fc"
  }
}
